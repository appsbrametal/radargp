# Copie este ficheiro para .env.local e preencha com os dados do seu projeto Supabase.
# Painel > Project Settings > API.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_PUBLICA

# NUNCA coloque a service_role key aqui (nem em nenhum ficheiro VITE_*) —
# essa chave só existe do lado do servidor, nas Edge Functions
# (configurada com `supabase secrets set`, não neste .env).
